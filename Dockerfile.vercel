FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /source
COPY services/ services/
COPY database/ database/
RUN dotnet restore services/DragonLord.Api/DragonLord.Api.csproj
RUN dotnet publish services/DragonLord.Api/DragonLord.Api.csproj --configuration Release --output /out --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0-bookworm-slim
WORKDIR /app
COPY --from=build /out/ ./
ENV ASPNETCORE_URLS=http://0.0.0.0:8080 ASPNETCORE_ENVIRONMENT=Production PORT=8080 DOTNET_EnableDiagnostics=0
EXPOSE 8080
USER $APP_UID
ENTRYPOINT ["dotnet", "DragonLord.Api.dll"]
