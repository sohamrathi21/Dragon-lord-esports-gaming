# Live frontend uses same-origin /api and /hubs. Never put secrets in VITE_*.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080
ConnectionStrings__Cafe=Host=localhost;Port=5432;Database=dragonlord;Username=dragonlord;Password=REPLACE_ME;MaxPoolSize=5;SSL Mode=VerifyFull
Runtime__Mode=VenueController
POSTGRES_PASSWORD=REPLACE_ME
Razorpay__KeyId=
Razorpay__KeySecret=
Razorpay__WebhookSecret=
Razorpay__AllowLive=false
N8n__WebhookUrl=http://127.0.0.1:5678/webhook/dragon-lord-events
N8n__HeaderSecret=
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PORT=5678
N8N_DIAGNOSTICS_ENABLED=false
DRAGON_STATION_ID=PC-01
DRAGON_CONTROLLER_DB=controller-simulator.db

# Public Windows release metadata. Leave URL empty until an actual installer exists.
VITE_WINDOWS_INSTALLER_URL=
VITE_WINDOWS_APP_VERSION=
VITE_WINDOWS_DOWNLOAD_SIZE=
VITE_WINDOWS_SUPPORTED_VERSIONS=
